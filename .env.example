# ==============================================================================
# WesdSystems - Variables d'environnement
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (Obligatoire pour l'application frontend & backend)
# ------------------------------------------------------------------------------
# URL de votre projet Supabase (ex: https://xxxxxxxxxxxxxxxxxxxx.supabase.co)
VITE_SUPABASE_URL=https://votre-projet.supabase.co

# Clé publique anonyme (Anon / Public Key)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clé secrète d'administration (Service Role Key - UNIQUEMENT côté serveur / Vercel API / Scripts)
# NE PAS exposer côté client avec VITE_ si non strictement nécessaire
SUPABASE_SERVICE_ROLE_KEY=votre_service_role_key_ici

# ------------------------------------------------------------------------------
# 2. INTELLIGENCE ARTIFICIELLE (Google Gemini)
# ------------------------------------------------------------------------------
# Clé API Google AI Studio / Gemini (utilisée pour l'analyse IA de documents)
VITE_GEMINI_API_KEY=votre_gemini_api_key

# ------------------------------------------------------------------------------
# 3. DOMAINE & PAIEMENTS MONCASH (Haïti)
# ------------------------------------------------------------------------------
# Domaine public du projet (ex: wesdsystems.store ou localhost:5173 en dev)
VITE_PUBLIC_DOMAIN=wesdsystems.store

# Configuration MonCash API (pour Vercel / serverless routes dans api/)
MONCASH_MODE=live                  # "sandbox" ou "live"
MONCASH_CLIENT_ID=votre_client_id
MONCASH_CLIENT_SECRET=votre_client_secret
MONCASH_BUSINESS_KEY=votre_business_key
PUBLIC_URL=https://wesdsystems.store

# ------------------------------------------------------------------------------
# 4. EMAILS & EDGE FUNCTIONS (Supabase Edge Functions / Resend)
# ------------------------------------------------------------------------------
# Variables pour supabase/functions/send-confirmation-email
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=no-reply@votredomaine.com
ALLOWED_ORIGINS=https://wesdsystems.store,http://localhost:5173
